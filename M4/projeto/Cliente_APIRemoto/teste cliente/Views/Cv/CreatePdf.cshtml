@model teste_cliente.Models.CV
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    Layout = null;
    
    string imgSrc;
    if (Model.FotoPerfil != null && Model.FotoPerfil.Length > 0)
    {
        var base64 = Convert.ToBase64String(Model.FotoPerfil);
        imgSrc = $"data:image/jpeg;base64,{base64}";
    }
    else
    {
        // imgSrc = Url.Content("~/img/icone_perfil.png");
    
        var caminhoFisico = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "img", "icone_perfil.png");

        if (System.IO.File.Exists(caminhoFisico))
        {
            var bytesIcone = System.IO.File.ReadAllBytes(caminhoFisico);
            var base64Icone = Convert.ToBase64String(bytesIcone);
            imgSrc = $"data:image/png;base64,{base64Icone}";
        }
        else
        {
            imgSrc = ""; // Fallback caso o ficheiro suma
        }
    }    
}

<div class="container mt-4" style="font-family: Arial, sans-serif; color: #333;">
    <div class="text-center mb-4">
        
        <div style="width: 120px; height: 120px; overflow: hidden; border-radius: 60px; display: inline-block;">
            <img src="@imgSrc"
                 onerror="this.onerror=null; this.src='@imgSrc'"
                 alt="Foto de perfil"
                 width="120"
                 height="120"
                 style="display: block; max-width: 100%; height: auto;" />
        </div>

        <h1 style="margin-top: 10px; font-size: 24px;">@Model.Nome</h1>

    </div>

    <hr style="border: none; height: 1px; background-color: #ccc;" />

    <section style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 8px;">Concelho</h2>
        <p style="font-size: 14px; color: #666;">@Model.Concelho.GetDisplayName()</p>
    </section>

    <section style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 8px;">Educação</h2>
        <p style="font-size: 14px; white-space: pre-wrap;">@Model.Escolaridade.GetDisplayName()</p>
    </section>

    <section style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 8px;">Experiência Profissional</h2>
        <p style="font-size: 14px; white-space: pre-wrap;">@Model.ExpProfissional</p>
    </section>

    <section style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 8px;">Competências</h2>
        <p style="font-size: 14px; white-space: pre-wrap;">@Model.Competencias</p>
    </section>

    <section style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 8px;">Interesses</h2>
        <p style="font-size: 14px; white-space: pre-wrap;">@Model.Interesses</p>
    </section>
</div>
