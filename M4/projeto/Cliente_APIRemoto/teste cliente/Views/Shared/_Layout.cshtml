@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpAcc
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Jobs - Ofertas de emprego</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/FlatlyTheme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css" asp-append-version="true" />

    @* CSS para as noticias *@
    <link rel="stylesheet" href="~/css/NewsStyle.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <style>
            .notification-item {
                padding: 10px 15px;
                border-bottom: 1px solid #f0f0f0;
                transition: background-color 0.2s;
            }

                .notification-item:hover {
                    background-color: #f8f9fa;
                }

                .notification-item.unread {
                    background-color: #e9ecef;
                    border-left: 4px solid #5de4d9;
                }

            .notification-actions {
                opacity: 0;
                transition: opacity 0.2s;
            }

            .notification-item:hover .notification-actions {
                opacity: 1;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm nav-bar-fundo">
            <div class="container-fluid menu-wrapper">
                <a href="/">
                    <img src="@Url.Content("~/img/logo.svg")" alt="Logotipo Jobs" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav menu">
                        <li class="nav-item">
                            <a class="nav-link link-menu" asp-area="" asp-controller="OfertaEmprego" asp-action="Index">Emprego</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link link-menu" asp-area="" asp-controller="Noticias" asp-action="Index">Noticias</a>
                        </li>

                    </ul>
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown d-flex align-items-center position-relative me-3">
                                <a class="nav-link d-flex align-items-center position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-bell fs-5"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">
                                        0
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="notificationDropdown" style="width: 350px;">
                                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                        <h6 class="m-0">Notificações</h6>
                                        <div>
                                            <button class="btn btn-sm btn-link text-decoration-none p-0 me-2" onclick="markAllNotificationsRead()">Ler Tudo</button>
                                            <button class="btn btn-sm btn-link text-danger text-decoration-none p-0" onclick="clearAllNotifications()">Limpar</button>
                                        </div>
                                    </div>
                                    <div id="notificationList" style="max-height: 400px; overflow-y: auto;">
                                        <div class="text-center p-3 text-muted" id="emptyState">A carregar...</div>
                                    </div>
                                </div>
                            </li>
                        }

                        @if (User.IsInRole(SD.Role_Empresa))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="menuEmpresa" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Empresa
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuEmpresa">
                                    @{
                                        var idempresa = User.FindFirst("IdEmpresa")?.Value;
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Empresa" asp-action="Details" asp-route-id="@idempresa">Perfil</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OfertaEmprego" asp-action="Create">Criar oferta</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OfertaEmprego" asp-action="Historico">Gerir ofertas</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">Logout</a>
                                    </li>
                                </ul>
                            </li>
                            <a asp-controller="Empresa" asp-action="Details" asp-route-id="@idempresa">
                                <img src="@Url.Action("GetLogoImage", "Logo", new { id = idempresa })"
                                     alt="Foto de Perfil"
                                     style="width: 50px; height: 50px; border-radius: 50%; object-fit: contain;" />
                            </a>
                        }

                        @if (User.IsInRole(SD.Role_Candidato))
                        {
                            <li class="nav-item d-flex align-items-center position-relative me-3">
                                <a class="nav-link d-flex align-items-center position-relative"
                                   href="javascript:void(0);"
                                   onclick="abrirFavoritos()"
                                   data-bs-toggle="modal"
                                   data-bs-target="#favoritosModal">

                                    <i class="bi bi-heart-fill fs-5"></i>
                                    <span id="favoritosBadge"
                                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                          style="background-color: #F2994A;">
                                        0
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle" href="#" id="menuCandidato" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Candidato
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuCandidato">
                                    @{
                                        var idCandidato = User.FindFirst("IdCandidato")?.Value;
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Candidato" asp-action="Details" asp-route-id="@idCandidato">Perfil</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Candidato" asp-action="HistoricoCandidaturas">Minhas Candidaturas</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CV" asp-action="Create">CV</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">Logout</a>
                                    </li>

                                </ul>
                            </li>

                            var candidatoId = User.FindFirst("IdCandidato")?.Value; // ID do candidato

                            <li class="nav-item">
                                @{
                                    var defaultImage = "/img/icone_perfil.png";

                                }
                                <a asp-controller="Candidato" asp-action="Details" asp-route-id="@candidatoId">
                                    <img src="@Url.Action("GetImage", "Foto", new { id = candidatoId })"
                                         onerror="this.onerror=null;this.src='@defaultImage'"
                                         alt="Foto de Perfil"
                                         style="width: 50px; height: 50px; border-radius: 50%;" />
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(SD.Role_Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="menuAdmin" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuAdmin">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Register">Criar Conta</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Empresa" asp-action="Index">Empresas</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Candidato" asp-action="Index">Candidatos</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">Logout</a>
                                    </li>
                                </ul>
                            </li>

                            <img src="~/img/icone_perfil.png"
                                 alt="Foto de Perfil"
                                 style="width: 50px; height: 50px; border-radius: 50%;" />
                        }
                    </ul>
                </div>
                <div align="right">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <table>
                            <tr>
                                <td>
                                    <a type="button" class="botao-login" asp-controller="Auth" asp-action="Login">Login</a>
                                </td>
                                <td>
                                    <a type="button" class="botao-registo" asp-controller="Auth" asp-action="Register">Registo</a>
                                </td>
                            </tr>
                        </table>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="modal fade" id="favoritosModal" tabindex="-1" aria-labelledby="favoritosModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ofertas Favoritas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="favoritosContainer" class="row g-3">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="footer_wrapper">
        <div class="footer">
            <div><img src="~/img/logo.svg" alt="Logotipo Jobs" /></div><div>&copy; 2025 JOBS - All rights Reserved</div><div><a asp-controller="Home" asp-action="Faq" class="faq_link">FAQ</a></div>
        </div>
    </footer>

    <div id="chat-widget" style="position: fixed; bottom: 20px; right: 20px; z-index: 1050; display: flex; flex-direction: column; align-items: flex-end;">

        <div id="chat-window" style="display: none; width: 350px; background: white; border: 1px solid #ddd; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.2); margin-bottom: 15px; overflow: hidden; font-family: sans-serif;">

            <div style="background: #ffc107; padding: 15px; font-weight: bold; text-align: center; color: #333; display: flex; justify-content: space-between; align-items: center;">
                <span>Assistente Virtual</span>
                <button onclick="toggleChat()" style="background: none; border: none; font-size: 16px; cursor: pointer; color: #333;">✖</button>
            </div>

            <div id="chat-box" style="height: 320px; overflow-y: auto; padding: 15px; background: #fdfdfd; font-size: 14px;">
                <div style="margin-bottom: 12px; background: #f1f1f1; padding: 10px; border-radius: 8px; display: inline-block; max-width: 85%;">
                    <strong>Assistente:</strong> <p style="margin: 5px 0 0 0;">Olá! Como te posso ajudar a encontrar o teu job de sonho hoje?</p>
                </div>
            </div>

            <div style="display: flex; padding: 10px; border-top: 1px solid #eee; background: white;">
                <input type="text" id="user-input" placeholder="Escreve aqui..." style="flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 4px; outline: none;" onkeypress="handleKeyPress(event)" />
                <button onclick="sendMessage()" style="margin-left: 8px; padding: 10px 15px; background: #212529; color: white; border: none; border-radius: 4px; cursor: pointer;">Enviar</button>
            </div>
        </div>

        <button onclick="toggleChat()" style="width: 60px; height: 60px; border-radius: 50%; background: #ffc107; border: none; box-shadow: 0 4px 10px rgba(0,0,0,0.3); cursor: pointer; font-size: 28px; display: flex; justify-content: center; align-items: center;">
            💬
        </button>
    </div>

    @Html.AntiForgeryToken()

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            atualizarBadgeFavoritos();
            
            // Verifica se o elemento do sino existe (usuário autenticado) antes de buscar notificações
            if (document.getElementById('notificationBadge')) {
                fetchNotifications();
            }
        });

        // ================= NOTIFICAÇÕES =================

        const API_BASE_URL = '@Configuration["ApiSettings:BaseUrl"]';

        // Note o ajuste para concatenar a base com o endpoint de notificações
        const API_URL = `${API_BASE_URL}notifications`;

        // Se usar JWT, adicione-o aqui. Se a API e o MVC estiverem no mesmo projeto e usarem cookies, não precisa do header de Authorization.
        const authHeaders = {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
            // 'Authorization': `Bearer ${localStorage.getItem('jwt')}` // Descomente se usar JWT
        };

        async function fetchNotifications() {
            try {
                const response = await fetch(API_URL, { headers: authHeaders });
                if (response.ok) {
                    const notifications = await response.json();
                    renderNotifications(notifications);
                }
            } catch (error) {
                console.error("Falha ao carregar notificações", error);
            }
        }

        function renderNotifications(notifications) {
            const list = document.getElementById('notificationList');
            const badge = document.getElementById('notificationBadge');
            
            list.innerHTML = ''; 
            
            if (!notifications || notifications.length === 0) {
                list.innerHTML = '<div class="text-center p-3 text-muted">Sem notificações</div>';
                badge.style.display = 'none';
                return;
            }

            let unreadCount = 0;

            notifications.forEach(n => {
                if (!n.isRead) unreadCount++;

                const item = document.createElement('div');
                item.className = `notification-item ${n.isRead ? '' : 'unread'}`;
                item.innerHTML = `
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="mb-1 text-sm" style="font-size: 0.9rem;">${n.message || 'Nova notificação'}</p>
                            <small class="text-muted" style="font-size: 0.75rem;">${new Date(n.createdAt).toLocaleString('pt-PT')}</small>
                        </div>
                        <div class="notification-actions d-flex flex-column align-items-end">
                            ${!n.isRead ? `<button class="btn btn-sm text-primary p-0 mb-1" onclick="markAsRead(${n.id})" title="Marcar como lida"><i class="fas fa-check-circle"></i></button>` : ''}
                            <button class="btn btn-sm text-danger p-0" onclick="deleteNotification(${n.id})" title="Apagar"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                `;
                list.appendChild(item);
            });

            if (unreadCount > 0) {
                badge.innerText = unreadCount;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        }

        async function markAsRead(id) {
            await fetch(`${API_URL}/mark-read/${id}`, { method: 'POST', headers: authHeaders });
            fetchNotifications(); 
        }

        async function markAllNotificationsRead() {
            await fetch(`${API_URL}/mark-all-read`, { method: 'POST', headers: authHeaders });
            fetchNotifications();
        }

        async function deleteNotification(id) {
            await fetch(`${API_URL}/${id}`, { method: 'DELETE', headers: authHeaders });
            fetchNotifications();
        }

        async function clearAllNotifications() {
            if(confirm("Tem a certeza que deseja limpar todas as notificações?")) {
                await fetch(`${API_URL}/clear-all`, { method: 'DELETE', headers: authHeaders });
                fetchNotifications();
            }
        }


        // ================= FAVORITOS (Seu código original) =================
        async function atualizarBadgeFavoritos() {
            try {
                const res = await fetch('/OfertaEmprego/GetFavoritosIds');
                if (!res.ok) {
                    console.error('Erro ao buscar favoritos:', res.status);
                    return;
                }

                const ids = await res.json();
                const badge = document.getElementById('favoritosBadge');

                if (badge) {
                    badge.textContent = ids.length || '0';
                }
            } catch (error) {
                console.error('Erro ao atualizar badge de favoritos:', error);
            }
        }

        async function abrirFavoritos() {
            try {
                const container = document.getElementById('favoritosContainer');
                container.innerHTML = '<p class="text-center">Carregando favoritos...</p>';

                const res = await fetch('/OfertaEmprego/GetOfertasFavoritas');
                if (!res.ok) {
                    throw new Error(`Erro ao carregar favoritos: ${res.status}`);
                }

                const ofertas = await res.json();
                container.innerHTML = '';

                if (!ofertas || ofertas.length === 0) {
                    container.innerHTML = '<p class="text-center text-muted">Nenhuma oferta favorita.</p>';
                    return;
                }

                ofertas.forEach(oferta => {

                const idOferta = oferta.idOferta || oferta.IdOferta; 
                const detailsUrl = `/OfertaEmprego/Details?id=${idOferta}`;

                    const card = `
                        <div class="col-md-6">
                            <div class="card shadow-sm rounded-3 mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">${oferta.titulo || 'Sem título'}</h5>
                                    <p class="card-text mb-1 text-muted">${oferta.localização || 'Localização não especificada'}</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <a href="${detailsUrl}" class="btn btn-primary btn-sm" style="border-radius: 30px; background-color: #5de4d9; border: 0;">Ver detalhes</a>
                                        <button class="btn btn-outline-warning btn-sm remove-favorito" data-id="${oferta.idOferta}" style="border-radius: 30px;">
                                            <i class="fas fa-star"></i> Remover
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    container.insertAdjacentHTML('beforeend', card);
                });

                document.querySelectorAll('.remove-favorito').forEach(btn => {
                    btn.addEventListener('click', async function() {
                        const id = this.getAttribute('data-id');
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const res = await fetch('/OfertaEmprego/ToggleFavorito', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': token
                            },
                            body: `idOferta=${id}`
                        });

                        const result = await res.json();

                        if (result.success) {
                            this.closest('.col-md-6').remove();

                            const starIcon = document.querySelector(`.toggle-favorito[data-id="${id}"]`);
                            if (starIcon) {
                                starIcon.classList.remove('fas');
                                starIcon.classList.add('far');
                                starIcon.style.color = "#ccc";
                            }

                            atualizarBadgeFavoritos();

                            if (document.querySelectorAll('#favoritosContainer .col-md-6').length === 0) {
                                document.getElementById('favoritosContainer').innerHTML =
                                    '<p class="text-center text-muted">Nenhuma oferta favorita.</p>';
                            }
                        }
                    });
                });
            } catch (error) {
                console.error('Erro ao carregar favoritos:', error);
                document.getElementById('favoritosContainer').innerHTML =
                    '<p class="text-center text-danger">Erro ao carregar ofertas favoritas: ' + error.message + '</p>';
            }
        }
    </script>

    <script>
            let chatHistory = [];

            // Abrir/Fechar a janela do chat
            function toggleChat() {
                const chatWindow = document.getElementById('chat-window');
                chatWindow.style.display = chatWindow.style.display === 'none' ? 'block' : 'none';
            }

            // Permitir envio com a tecla Enter
            function handleKeyPress(event) {
                if (event.key === 'Enter') {
                    sendMessage();
                }
            }

                    async function sendMessage() {
                const inputField = document.getElementById("user-input");
                const userText = inputField.value.trim();
                if (!userText) return;

                appendMessage("Tu", userText, "#e3f2fd");
                inputField.value = "";

                chatHistory.push({
                    role: "user",
                    parts: [{ text: userText }]
                });

                const loadingId = appendMessage("Assistente", "A escrever...", "#f1f1f1", true);

                try {
                    const response = await fetch('https://localhost:7211/api/chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ history: chatHistory })
                    });

                    // 1. Apagar a mensagem de "A escrever..." imediatamente e de forma segura
                    const loadingElement = document.getElementById(loadingId);
                    if (loadingElement) loadingElement.remove();

                    // 2. Verificar se o C# devolveu algum erro (ex: 404 ou 500)
                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error(`Erro do Servidor (${response.status}): ${errorText}`);
                    }

                    const data = await response.json();

                    // 3. Extrair e mostrar a resposta
                    const botText = data.candidates[0].content.parts[0].text;

                    appendMessage("Assistente", botText, "#f1f1f1");
                    chatHistory.push({
                        role: "model",
                        parts: [{ text: botText }]
                    });

                } catch (error) {
                    console.error("Erro detalhado:", error);

                    // Garantir que a mensagem de loading desaparece mesmo se der erro
                    const loadingElement = document.getElementById(loadingId);
                    if (loadingElement) loadingElement.remove();

                    appendMessage("Sistema", "Desculpa, ocorreu um erro de ligação.", "#ffebee");
                }
            }

            // Função utilitária para adicionar os balões de diálogo
            function appendMessage(sender, text, bgColor, isTemp = false) {
                const chatBox = document.getElementById("chat-box");
                const messageElement = document.createElement("div");
                const msgId = 'msg-' + Date.now() + Math.random().toString(36).substr(2, 9);

                messageElement.id = msgId;
                messageElement.style.marginBottom = "12px";
                messageElement.style.textAlign = sender === "Tu" ? "right" : "left";

                messageElement.innerHTML = `
                    <div style="background: ${bgColor}; padding: 10px; border-radius: 8px; display: inline-block; max-width: 85%; text-align: left;">
                        <strong>${sender}:</strong> <p style="margin: 5px 0 0 0;">${text}</p>
                    </div>
                `;

                chatBox.appendChild(messageElement);
                chatBox.scrollTop = chatBox.scrollHeight;
                return msgId;
            }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>